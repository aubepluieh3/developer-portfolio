{
  "name": "developer-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:unverified": "node --experimental-strip-types --no-warnings scripts/check-unverified.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "release": "npm run check:unverified && npm run typecheck && next build && npm run check:private"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
